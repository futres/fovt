    <!-- http://purl.obolibrary.org/obo/PATO_0070000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0070000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001340"/>
        <obo:IAO_0000115>A hermaphroditic quality that inheres in a population or organism where an organism changes is a different sexes during different life stages.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-8815-0078"/>
        <oboInOwl:hasExactSynonym>sequential hermaphroditic</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0070000</oboInOwl:id>
        <rdfs:comment>Sequential hermaphrodity is generally characterized by an organism producing female gametes and male gametes during different life stages.</rdfs:comment>
        <rdfs:label>sequential hermaphrodite</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0070000"/>
