    <!-- http://purl.obolibrary.org/obo/PATO_0000321 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000321">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000014"/>
        <obo:IAO_0000115>A color consisting of red and blue hues.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0000321</oboInOwl:id>
