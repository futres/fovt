    <!-- http://purl.obolibrary.org/obo/PATO_0040049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0040049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001894"/>
        <obo:IAO_0000115>A biological sex quality inhering in an individual or a population who are otherwise male of a non-hermaphroditic species who has ambiguous or atypical congenital development of the reproductive system.</obo:IAO_0000115>
        <pato:seeAlso>https://github.com/pato-ontology/pato/issues/482</pato:seeAlso>
        <oboInOwl:created_by>http://orcid.org/0000-0001-5208-3432</oboInOwl:created_by>
        <oboInOwl:hasBroadSynonym>intersex</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>male with differences of sexual differentiation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>male with disorder of sexual development</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>male, DSD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0040049</oboInOwl:id>
        <rdfs:comment>The term intersex is popular in use, but may be considered offensive when applied to humans. DSD can be expanded multiple ways to &apos;disorders/differences of sexual development/differentiation&apos;.</rdfs:comment>
        <rdfs:label>male with DSD</rdfs:label>
    </owl:Class>
    


