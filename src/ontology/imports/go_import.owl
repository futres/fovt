AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0048513> "GO:0048513")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0048513> "animal organ development")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0048513> <http://purl.obolibrary.org/obo/GO_0048856>)

