xref: neuronames:3233
xref: PBA:294021932
xref: VO:0011276 {sssom:mapping_justification="https://w3id.org/semapv/vocab/ManualMappingCuration", pav:authoredBy="https://orcid.org/0000-0003-4423-4370"}
