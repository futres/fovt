synonym: "definitive kidney" RELATED [BTO:0001543]
synonym: "hind kidney" RELATED [BTO:0001543]
synonym: "metanephric kidney" RELATED [VHOG:0000039]
synonym: "metanephron" EXACT [BTO:0001543]
